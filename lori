#!/bin/sh
# Release archives include Lori's Python runtime; source checkouts use Python 3.
LORI_DIRECTORY=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
if [ -x "$LORI_DIRECTORY/.lori-bin/lori" ]; then
    exec "$LORI_DIRECTORY/.lori-bin/lori" "$@"
fi
exec python3 "$LORI_DIRECTORY/tools/lori_entry.py" "$@"
